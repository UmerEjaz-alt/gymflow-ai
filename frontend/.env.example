# Get these values from your Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role / secret key for trusted system jobs (automation runner, cron). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative name for the same secret key (Supabase "sb_secret_..." format):
# SUPABASE_SECRET_KEY=

# WhatsApp / Meta webhook
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret used to verify X-Hub-Signature-256 on incoming webhook POSTs.
WHATSAPP_APP_SECRET=

# At least 32 random characters. Used only to hash durable rate-limit keys.
RATE_LIMIT_SECRET=
# Server-only permanent/system-user token for Meta WhatsApp Cloud API text sends.
WHATSAPP_ACCESS_TOKEN=
# Set this to a currently supported Meta Graph API version, e.g. vXX.X.
WHATSAPP_GRAPH_API_VERSION=
DEFAULT_GYM_ID=

# Active AI provider: gemini, cerebras, or groq.
ACTIVE_AI_PROVIDER=gemini

# AI provider credentials (server-only). Only the active provider's key is required.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
# Required only when ACTIVE_AI_PROVIDER=groq.
GROQ_MODEL=

# Automation scheduler
AUTOMATION_RUNNER_SECRET=
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET}; either secret works on /api/automations/run.
# CRON_SECRET=
# Local dev scheduler runs automatically when NODE_ENV=development.
# Set to "false" to disable the in-process dev scheduler.
# AUTOMATION_SCHEDULER_ENABLED=false
# Interval between scheduler ticks in milliseconds (default: 86400000 = 24 hours).
# AUTOMATION_SCHEDULER_INTERVAL_MS=86400000
# Base URL used by the local dev scheduler when calling /api/automations/run.
# APP_URL=http://localhost:3000

# Public demo requests (server-only)
DEMO_NOTIFICATION_EMAIL=umerejaz650@gmail.com
# Verified sender identity in Resend, e.g. Kroway <hello@kroway.app>
DEMO_FROM_EMAIL=
RESEND_API_KEY=
